From 46edb7803b63b25e159cae27b1bd9ea6b0b8db9d Mon Sep 17 00:00:00 2001
From: Aadi Srivastava <aadisrivastava.iitm@gmail.com>
Date: Mon, 12 Oct 2026 06:21:23 +0000
Subject: [PATCH 05/24] Decide carried pointers per function, and price LICM's
 hoists

Two gates gave different answers to the same question. The interior-pointer
hoist asked polls_are_impossible, which consults the function's [@poll error]
attribute as well as the unit's polling setting; carrying a pointer across a
back edge asked only the unit's setting, as did the matching Addr check in
Cfg_selectgen. So a function could form an interior pointer and then be unable
to keep it. Both now ask polls_are_impossible, which needs the selector to know
the attribute: Select_utils.current_function_poll, set per function by
emit_fundecl beside current_function_name.

This does not make the per-function route usable. [@poll error] rejects any
loop with a runtime trip count, because the back edge is exactly where the poll
goes -- so no kernel loop can carry the annotation, and on a compiler built
--enable-poll-insertion these two optimizations are unavailable. Measured on
microgpt: the four passes are worth +28.0% (11/11 rounds) where there are no
safepoints and +10.8% (11/11) where there are. The gates agreeing is still
worth having; the gap it exposes is the finding.

Also give hoist_invariants a cost model. It hoisted only where every operand
died, which is register-neutral by construction but declines wherever the
operands are live elsewhere -- an invariant multiply in an inner loop, say.
A definition dear enough to pay for a register may now leave the loop while
there is budget for it and the loop carries few enough values. On every loop
shape measured so far this changes nothing: the invariant multiply that
prompted it never reaches a Clet, flambda2 having inlined it into the address
operand, and hoist_invariants only walks Clet bindings. Hoisting it needs the
pass to introduce a binding for an invariant subexpression inside an address,
which is a larger change than this one.
---
 backend/cfg_selectgen.ml          | 22 ++++++++----
 backend/cmm_strength_reduction.ml | 59 +++++++++++++++++++++++++++----
 backend/select_utils.ml           |  7 ++++
 backend/select_utils.mli          |  2 ++
 4 files changed, 78 insertions(+), 12 deletions(-)

diff --git a/backend/cfg_selectgen.ml b/backend/cfg_selectgen.ml
index dac6027052..d3571f4fe2 100644
--- a/backend/cfg_selectgen.ml
+++ b/backend/cfg_selectgen.ml
@@ -1407,13 +1407,22 @@ module Make (Target : Cfg_selectgen_target_intf.S) = struct
         let tmp_regs = Reg.createv_with_typs src in
         (* Ccatch registers must not contain out of heap pointers: a derived
            pointer live across the back edge of a loop is live across that
-           loop's poll, and the collector cannot update it. Where the unit is
-           compiled without polling there is no such safepoint, and
-           [Cmm_strength_reduction] carries row pointers across loops that it
-           has also shown cannot allocate. Emit.ml still refuses an [Addr] live
-           at any frame descriptor, so a mistake is a compile error. *)
+           loop's poll, and the collector cannot update it. Where there is no
+           safepoint there is no such poll, and [Cmm_strength_reduction]
+           carries row pointers only across loops it has also shown cannot
+           allocate. That holds when the unit is compiled without polling, and
+           equally when this one function is annotated [@poll error], which
+           makes any remaining polling point a compile error -- so a kernel can
+           opt in without the program around it giving up its safepoints.
+           Emit.ml still refuses an [Addr] live at any frame descriptor, so a
+           mistake is a compile error either way. *)
         let carried_pointers_are_safe =
-          (not Config.poll_insertion) || !Oxcaml_flags.disable_poll_insertion
+          (not Config.poll_insertion)
+          || !Oxcaml_flags.disable_poll_insertion
+          ||
+          match !SU.current_function_poll with
+          | Lambda.Error_poll -> true
+          | Lambda.Default_poll -> false
         in
         Array.iter
           (fun reg ->
@@ -1749,6 +1758,7 @@ module Make (Target : Cfg_selectgen_target_intf.S) = struct
 
   let emit_fundecl ~future_funcnames f =
     SU.current_function_name := f.Cmm.fun_name.sym_name;
+    SU.current_function_poll := f.Cmm.fun_poll;
     SU.current_function_is_check_enabled
       := Zero_alloc_checker.is_check_enabled f.Cmm.fun_codegen_options
            f.Cmm.fun_name.sym_name f.Cmm.fun_dbg;
diff --git a/backend/cmm_strength_reduction.ml b/backend/cmm_strength_reduction.ml
index 5b249bf153..9e6fd9b8c7 100644
--- a/backend/cmm_strength_reduction.ml
+++ b/backend/cmm_strength_reduction.ml
@@ -1249,6 +1249,32 @@ let reduce_invariant_strides ~duplicated ~int_vars ~relaxed ~carry_pointers
    there are registers left to hold them. *)
 let max_hoisted = 4
 
+(* What it costs to recompute a definition once. Hoisting pays that cost once
+   instead of every iteration, in exchange for one value live across the loop.
+   An add or a shift is not worth a register: the addressing modes absorb those
+   for free, and spilling one value to save one [lea] is a loss. A multiply is,
+   at three to four cycles and a port the loop's arithmetic also wants. *)
+let rec recompute_cost expr =
+  let args_cost args = List.fold_left (fun n a -> n + recompute_cost a) 0 args in
+  match expr with
+  | Cconst_int _ | Cconst_natint _ | Cvar _ -> 0
+  | Cop (Cmuli, args, _) -> 3 + args_cost args
+  | Cop ((Caddi | Csubi | Cand | Cor | Cxor | Clsl | Clsr | Casr), args, _) ->
+    1 + args_cost args
+  | _ -> 1
+
+(* A definition this expensive earns its register even when no operand dies. *)
+let min_cost_under_pressure = 3
+
+(* How many such bindings may leave one loop, and how many values that loop may
+   already carry before none may. The loop already ties up one register per
+   carried value; below this there are enough left that one more live range
+   does not force a spill, and above it the measurement that produced this pass
+   says hoisting loses. *)
+let max_pressure_hoists = 2
+
+let max_carried_under_pressure = 6
+
 let hoist_invariants ~duplicated ~int_vars ~relaxed ~counts ~expr =
   let flag, handlers, body =
     match expr with
@@ -1281,12 +1307,33 @@ let hoist_invariants ~duplicated ~int_vars ~relaxed ~counts ~expr =
         | None -> false)
       (occurrence_counts def)
   in
+  (* Values the loop already holds in registers across its back edge. *)
+  let carried =
+    List.fold_left
+      (fun n (handler : static_handler) -> n + List.length handler.params)
+      0 handlers
+  in
+  let pressure_budget =
+    ref
+      (if carried <= max_carried_under_pressure then max_pressure_hoists else 0)
+  in
+  (* Register-neutral hoists are always taken. One that adds a live range is
+     taken only while there is budget for it and the computation it removes is
+     dear enough to pay for the register -- which is what lets an invariant
+     multiply leave a loop whose operands are all live elsewhere anyway. *)
+  let affordable def =
+    operands_die def
+    || recompute_cost def >= min_cost_under_pressure
+       && !pressure_budget > 0
+       && (decr pressure_budget;
+           true)
+  in
   let hoistable v def =
     (not (V.Set.mem v duplicated))
     && List.compare_length_with !hoisted max_hoisted < 0
     && worth def
     && invariant_int ~invariant ~int_vars ~relaxed def
-    && operands_die def
+    && affordable def
   in
   let rec loop expr =
     match expr with
@@ -1430,12 +1477,12 @@ let fundecl (fundecl : fundecl) =
   let invariant_strides = !Oxcaml_flags.cmm_invariant_strides in
   let licm = !Oxcaml_flags.cmm_licm in
   (* A carried pointer is live across the loop's back edge, which is where a
-     poll would go, so it is only representable where the whole unit is compiled
-     without polling; [Cfg_selectgen] admits an [Addr] in a [Ccatch] register
-     under exactly this condition. *)
+     poll would go, so it is only representable where that loop has no
+     safepoint: either the whole unit is compiled without polling, or this
+     function is annotated [@poll error]. [Cfg_selectgen] admits an [Addr] in a
+     [Ccatch] register under exactly the same condition. *)
   let carry_pointers =
-    !Oxcaml_flags.cmm_carried_pointers
-    && ((not Config.poll_insertion) || !Oxcaml_flags.disable_poll_insertion)
+    !Oxcaml_flags.cmm_carried_pointers && polls_are_impossible fundecl
   in
   if not (strength_reduction || form_interior_pointers || licm)
   then fundecl
diff --git a/backend/select_utils.ml b/backend/select_utils.ml
index fbd4e3e4e1..8ab9db65d9 100644
--- a/backend/select_utils.ml
+++ b/backend/select_utils.ml
@@ -375,6 +375,13 @@ let current_function_name = ref ""
 
 let current_function_is_check_enabled = ref false
 
+(* Poll attribute of the function being compiled. A function annotated
+   [@poll error] is rejected by [Cfg_polling] if it needs a safepoint at all,
+   so inside one there is no point at which the collector can run and no
+   derived pointer it could fail to update. Tracking it per function is what
+   lets a single kernel opt in without the whole unit giving up polling. *)
+let current_function_poll = ref Lambda.Default_poll
+
 module Effect = struct
   type t =
     | None
diff --git a/backend/select_utils.mli b/backend/select_utils.mli
index be928a6b1b..062226fc33 100644
--- a/backend/select_utils.mli
+++ b/backend/select_utils.mli
@@ -126,6 +126,8 @@ val current_function_name : string ref
 
 val current_function_is_check_enabled : bool ref
 
+val current_function_poll : Lambda.poll_attribute ref
+
 module Effect : sig
   type t =
     | None
