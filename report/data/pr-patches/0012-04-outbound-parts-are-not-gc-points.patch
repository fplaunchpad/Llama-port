+(* The parts of [body], a handler body of the loop whose handlers (nested ones
+   included) are [inside], that run only on the way out of the loop: an exit to
+   a label outside the loop, and a subexpression in tail position that never
+   exits to a label inside it. Once control reaches one of them the loop is
+   over. With [~tail:false] only the exits count (for the code that enters the
+   loop). The parts are returned as a predicate on physical identity, so the
+   caller must ask about subexpressions of [body] itself. *)
+let outbound_parts ~inside ~tail body =
+  let parts = ref [] in
+  let rec walk ~tail expr =
+    match expr with
+    | Cexit (target, _, _) when leaves ~inside target -> parts := expr :: !parts
+    | _ when tail && not (jumps_inside ~inside expr) -> parts := expr :: !parts
+    | Clet (_, def, body) ->
+      walk ~tail:false def;
+      walk ~tail body
+    | Cphantom_let (_, _, body) | Cname_for_debugger (_, body) ->
+      walk ~tail body
+    | Csequence (e1, e2) ->
+      walk ~tail:false e1;
+      walk ~tail e2
+    | Cifthenelse (cond, _, ifso, _, ifnot, _) ->
+      walk ~tail:false cond;
+      walk ~tail ifso;
+      walk ~tail ifnot
+    | Cswitch (sel, _, cases, _) ->
+      walk ~tail:false sel;
+      Array.iter (fun (case, _) -> walk ~tail case) cases
+    | Ccatch (_, handlers, body) ->
+      walk ~tail body;
+      List.iter
+        (fun (handler : static_handler) -> walk ~tail handler.body)
+        handlers
+    | _ -> iter_subexpressions (walk ~tail:false) expr
+  in
+  walk ~tail body;
+  let parts = !parts in
+  fun expr -> List.exists (fun part -> part == expr) parts
+
+(* The outbound parts of the handlers of the loop [node]. *)
+let outbound_of_handler ~node (handler : static_handler) =
+  outbound_parts ~inside:(handler_labels [] node) ~tail:true handler.body
+
+(* Does no collection happen while the loop [node] runs? A nested loop is
+   covered by the same walk: a back edge only carries a poll when polling is
+   enabled, and the caller has already established that it is not.
+
+   The parts of the loop that run only on the way out of it ([outbound_parts])
+   are not inspected: a safepoint there is a safepoint after the loop, which is
+   where a counted loop polls anyway. That is sound for the pointer passes
+   because they leave those parts alone ([skip_outbound], [without_outbound]),
+   so nothing they derive is used there and nothing read there is read early.
+   This admits the common loop that boxes its float accumulator as it leaves. *)
+let is_gc_free_loop node =
+  let rec gc_free ~out expr =
+    if out expr
+    then true
+    else
+      match expr with
+      | Cop (op, _, _) when operation_is_safepoint op -> false
+      | _ ->
+        let safe = ref true in
+        iter_subexpressions
+          (fun sub -> if !safe then safe := gc_free ~out sub)
+          expr;
+        !safe
+  in
+  match node with
+  | Ccatch (_, handlers, body) ->
+    let inside = handler_labels [] node in
+    gc_free ~out:(outbound_parts ~inside ~tail:false body) body
+    && List.for_all
+         (fun (handler : static_handler) ->
+           gc_free ~out:(outbound_of_handler ~node handler) handler.body)
+         handlers
+  | _ -> gc_free ~out:(fun _ -> false) node
+
+(* [rewrite expr], or [expr] itself if it is an outbound part. *)
+let skip_outbound ~out rewrite expr = if out expr then expr else rewrite expr
+
+(* [expr] with its outbound parts replaced by a constant. For analyses that must
+   not see bindings made there. *)
+let rec without_outbound ~out expr =
+  if out expr
+  then Ctuple []
+  else map_subexpressions (without_outbound ~out) expr
 
