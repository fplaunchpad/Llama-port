diff --git a/oxcaml/tests/backend/counted_loops/kernels.ml b/oxcaml/tests/backend/counted_loops/kernels.ml
new file mode 100755
index 0000000000..baff6e254e
--- /dev/null
+++ b/oxcaml/tests/backend/counted_loops/kernels.ml
@@ -0,0 +1,77 @@
+(* Kernels that the pointer passes rewrite inside counted loops, run with the
+   GC kept busy (a young copy of every array, Gc.compact between kernels).
+   The output must not depend on -cmm-counted-loops; kernels.expected was
+   produced without it. *)
+
+let o x = Sys.opaque_identity x
+
+let h = ref 0L
+
+let mix x = h := Int64.add (Int64.mul !h 1000003L) x
+
+let[@inline never] matvec (m : float array) (v : float array) (out : float array)
+    rows cols =
+  for r = 0 to rows - 1 do
+    let b = r * cols in
+    let s = ref 0.0 in
+    for c = 0 to cols - 1 do
+      s := !s +. (m.(b + c) *. v.(c))
+    done;
+    out.(r) <- !s
+  done
+
+let[@inline never] matvec4 (m : float array) (v : float array)
+    (out : float array) rows cols =
+  let r = ref 0 in
+  while !r + 3 < rows do
+    let b0 = !r * cols in
+    let b1 = b0 + cols and b2 = b0 + (2 * cols) and b3 = b0 + (3 * cols) in
+    let s0 = ref 0.0 and s1 = ref 0.0 and s2 = ref 0.0 and s3 = ref 0.0 in
+    for c = 0 to cols - 1 do
+      let x = v.(c) in
+      s0 := !s0 +. (m.(b0 + c) *. x);
+      s1 := !s1 +. (m.(b1 + c) *. x);
+      s2 := !s2 +. (m.(b2 + c) *. x);
+      s3 := !s3 +. (m.(b3 + c) *. x)
+    done;
+    out.(!r) <- !s0;
+    out.(!r + 1) <- !s1;
+    out.(!r + 2) <- !s2;
+    out.(!r + 3) <- !s3;
+    r := !r + 4
+  done;
+  while !r < rows do
+    let s = ref 0.0 in
+    for c = 0 to cols - 1 do
+      s := !s +. (m.((!r * cols) + c) *. v.(c))
+    done;
+    out.(!r) <- !s;
+    incr r
+  done
+
+let[@inline never] shifted (a : int array) b n =
+  let s = ref 0 in
+  let i = ref 0 in
+  while !i < n do
+    s := !s + a.(b + !i) + a.(!i + b + 1);
+    i := !i + 3
+  done;
+  !s
+
+let () =
+  let rows = o 19 and cols = o 37 in
+  let m0 = Array.init (rows * cols) (fun i -> float_of_int ((i * 7919) mod 1009) /. 7.0) in
+  let v0 = Array.init cols (fun i -> float_of_int (i - 20) /. 3.0) in
+  for rep = 0 to 20 do
+    let m = Array.map (fun x -> x +. float_of_int rep) m0 in
+    let v = Array.copy v0 in
+    let out = Array.make rows 0.0 in
+    matvec m v out rows cols;
+    Array.iter (fun x -> mix (Int64.bits_of_float x)) out;
+    Gc.compact ();
+    matvec4 m v out rows cols;
+    Array.iter (fun x -> mix (Int64.bits_of_float x)) out;
+    let a = Array.init 1000 (fun i -> i * rep) in
+    mix (Int64.of_int (shifted a (o 7) (o 900)))
+  done;
+  Printf.printf "%Ld\n" !h
