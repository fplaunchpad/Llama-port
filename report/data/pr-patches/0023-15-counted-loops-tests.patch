diff --git a/oxcaml/tests/backend/counted_loops/decisions.ml b/oxcaml/tests/backend/counted_loops/decisions.ml
new file mode 100755
index 0000000000..151dd9ae11
--- /dev/null
+++ b/oxcaml/tests/backend/counted_loops/decisions.ml
@@ -0,0 +1,98 @@
+(* -dcounted-loops decisions for the loop shapes the counted-loop matcher
+   distinguishes. One function per shape; the expected output is
+   decisions.output. *)
+
+(* A [for] loop: the bound is a tagged value shifted right, so [i <= n] cannot
+   wrap. Proved without a check. *)
+let[@inline never] for_up (a : int array) n =
+  let s = ref 0 in
+  for i = 0 to n - 1 do
+    s := !s + Array.unsafe_get a i
+  done;
+  !s
+
+(* [downto] is the mirror image. *)
+let[@inline never] for_down (a : int array) n =
+  let s = ref 0 in
+  for i = n - 1 downto 0 do
+    s := !s + Array.unsafe_get a i
+  done;
+  !s
+
+(* [i < n] stepping by 16 wraps if [n] is near [max_int]: entry check. *)
+let[@inline never] lt_step16 (a : int array) n =
+  let i = ref 0 and s = ref 0 in
+  while !i < n do
+    s := !s + Array.unsafe_get a (!i land 15);
+    i := !i + 16
+  done;
+  !s
+
+(* [i <> n] stepping by 2 never ends if [n - i] is odd: entry check. *)
+let[@inline never] ne_step2 (a : int array) n =
+  let i = ref 0 and s = ref 0 in
+  while !i <> n do
+    s := !s + Array.unsafe_get a (!i land 15);
+    i := !i + 2
+  done;
+  !s
+
+(* [i <= max_int] never fails: never counted. *)
+let[@inline never] le_max (a : int array) =
+  let i = ref 0 and s = ref 0 in
+  while !i <= max_int && !s >= 0 do
+    s := !s + Array.unsafe_get a (!i land 15);
+    i := !i + 1
+  done;
+  !s
+
+(* An allocation in the body: declined. *)
+let[@inline never] allocates n =
+  let l = ref [] in
+  for i = 0 to n - 1 do
+    l := i :: !l
+  done;
+  !l
+
+(* An inner loop whose check depends only on values bound outside the outer
+   loop: lifted to the outer loop's entry. *)
+let[@inline never] nest_lifted (a : int array) rows n =
+  let s = ref 0 in
+  for r = 0 to rows - 1 do
+    let m = n + 1 in
+    let j = ref 0 in
+    while !j < m do
+      s := !s + Array.unsafe_get a ((r + !j) land 15);
+      j := !j + 16
+    done
+  done;
+  !s
+
+(* An inner check that reads the outer counter: not liftable. *)
+let[@inline never] nest_dependent (a : int array) rows n =
+  let s = ref 0 in
+  for r = 0 to rows - 1 do
+    let m = n + r in
+    let j = ref 0 in
+    while !j < m do
+      s := !s + Array.unsafe_get a (!j land 15);
+      j := !j + 16
+    done
+  done;
+  !s
+
+(* No test dominates the back edge that steps the counter. *)
+let[@inline never] no_guard (a : int array) n flag =
+  let i = ref 0 and go = ref true and s = ref 0 in
+  while !go do
+    if !i < n || flag then i := !i + 1 else go := false;
+    s := !s + Array.unsafe_get a (!i land 15)
+  done;
+  !s
+
+(* A spin on an atomic: GC-free, but it is a loop the counted-loop proof
+   cannot apply to (no counter). *)
+let[@inline never] spin (x : int Atomic.t) =
+  while Atomic.get x = 0 do
+    Domain.cpu_relax ()
+  done
