diff --git a/oxcaml/tests/backend/counted_loops/dune b/oxcaml/tests/backend/counted_loops/dune
new file mode 100755
index 0000000000..6143ddc4fe
--- /dev/null
+++ b/oxcaml/tests/backend/counted_loops/dune
@@ -0,0 +1,153 @@
+; Counted loops (-cmm-counted-loops): which loops are made poll-free, and
+; that the kernels the pointer passes rewrite inside them compute the same
+; results.
+
+(rule
+ (enabled_if
+  (and
+   (= %{context_name} "main")
+   (= %{architecture} "amd64")))
+ (targets decisions.output.corrected)
+ (deps decisions.ml)
+ (action
+  (with-stderr-to
+   decisions.output.corrected
+   (run
+    %{bin:ocamlopt.opt}
+    %{deps}
+    -c
+    -O3
+    -cmm-counted-loops
+    -dcounted-loops
+    -color
+    never
+    -w
+    -a))))
+
+(rule
+ (alias runtest)
+ (enabled_if
+  (and
+   (= %{context_name} "main")
+   (= %{architecture} "amd64")))
+ (deps decisions.output decisions.output.corrected)
+ (action
+  (diff decisions.output decisions.output.corrected)))
+
+(rule
+ (enabled_if
+  (and
+   (= %{context_name} "main")
+   (= %{architecture} "amd64")))
+ (targets kernels_counted.exe)
+ (deps kernels.ml)
+ (action
+  (run
+   %{bin:ocamlopt.opt}
+   %{deps}
+   -O3
+   -cmm-counted-loops
+   -o
+   kernels_counted.exe)))
+
+(rule
+ (enabled_if
+  (and
+   (= %{context_name} "main")
+   (= %{architecture} "amd64")))
+ (targets kernels.output)
+ (deps kernels_counted.exe)
+ (action
+  (with-stdout-to
+   kernels.output
+   (setenv
+    OCAMLRUNPARAM
+    s=4k
+    (run ./kernels_counted.exe)))))
+
+(rule
+ (alias runtest)
+ (enabled_if
+  (and
+   (= %{context_name} "main")
+   (= %{architecture} "amd64")))
+ (deps kernels.expected kernels.output)
+ (action
+  (diff kernels.expected kernels.output)))
+
+; -cmm-counted-loops-max-trips: which loops get the trip-count check, and that
+; capped loops compute the same results through either version.
+
+(rule
+ (enabled_if
+  (and
+   (= %{context_name} "main")
+   (= %{architecture} "amd64")))
+ (targets tripcap_decisions.output.corrected)
+ (deps tripcap.ml)
+ (action
+  (with-stderr-to
+   tripcap_decisions.output.corrected
+   (run
+    %{bin:ocamlopt.opt}
+    %{deps}
+    -c
+    -O3
+    -cmm-counted-loops
+    -cmm-counted-loops-max-trips
+    1000
+    -dcounted-loops
+    -color
+    never
+    -w
+    -a))))
+
+(rule
+ (alias runtest)
+ (enabled_if
+  (and
+   (= %{context_name} "main")
+   (= %{architecture} "amd64")))
+ (deps tripcap_decisions.output tripcap_decisions.output.corrected)
+ (action
+  (diff tripcap_decisions.output tripcap_decisions.output.corrected)))
+
+(rule
+ (enabled_if
+  (and
+   (= %{context_name} "main")
+   (= %{architecture} "amd64")))
+ (targets tripcap.exe)
+ (deps tripcap.ml)
+ (action
+  (run
+   %{bin:ocamlopt.opt}
+   %{deps}
+   -O3
+   -cmm-counted-loops
+   -cmm-counted-loops-max-trips
+   1000
+   -o
+   tripcap.exe)))
+
+(rule
+ (enabled_if
+  (and
+   (= %{context_name} "main")
+   (= %{architecture} "amd64")))
+ (targets tripcap.output)
+ (deps tripcap.exe)
+ (action
+  (with-stdout-to
+   tripcap.output
+   (run ./tripcap.exe))))
+
+(rule
+ (alias runtest)
+ (enabled_if
+  (and
+   (= %{context_name} "main")
+   (= %{architecture} "amd64")))
+ (deps tripcap.expected tripcap.output)
+ (action
+  (diff tripcap.expected tripcap.output)))
