diff --git a/oxcaml/tests/backend/counted_loops/tripcap.ml b/oxcaml/tests/backend/counted_loops/tripcap.ml
new file mode 100755
index 0000000000..248d7a98a6
--- /dev/null
+++ b/oxcaml/tests/backend/counted_loops/tripcap.ml
@@ -0,0 +1,46 @@
+(* -cmm-counted-loops-max-trips: which loops get the trip-count check, and
+   that the capped loops compute the same results whether they run their
+   poll-free version (short) or their polled copy (long). *)
+
+let[@inline never] sum (a : float array) n =
+  let s = ref 0. in
+  for i = 0 to n - 1 do
+    s := !s +. Array.unsafe_get a (i land 1023)
+  done;
+  !s
+
+let[@inline never] step16 (a : int array) n =
+  let s = ref 0 and j = ref 0 in
+  while !j < n do
+    s := !s + Array.unsafe_get a (!j land 1023);
+    j := !j + 16
+  done;
+  !s
+
+let[@inline never] down (a : int array) n =
+  let s = ref 0 in
+  for i = n downto 1 do
+    s := !s + Array.unsafe_get a (i land 1023)
+  done;
+  !s
+
+let[@inline never] nest (a : int array) m n =
+  let s = ref 0 in
+  for r = 0 to m - 1 do
+    for c = 0 to n - 1 do
+      s := !s + Array.unsafe_get a ((r + c) land 1023)
+    done
+  done;
+  !s
+
+let () =
+  let fa = Array.init 1024 float_of_int and ia = Array.init 1024 (fun i -> i) in
+  let o = Sys.opaque_identity in
+  List.iter
+    (fun n ->
+      Printf.printf "%d: %h %d %d %d\n" n
+        (sum fa (o n))
+        (step16 ia (o n))
+        (down ia (o n))
+        (nest ia (o 3) (o n)))
+    [0; 1; 999; 1000; 1001; 5000; 100000]
