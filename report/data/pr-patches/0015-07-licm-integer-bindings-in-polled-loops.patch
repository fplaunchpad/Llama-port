From f6a81cfe7f71b7397cd36132fa02ffd076b9975f Mon Sep 17 00:00:00 2001
From: local-rebase <local-rebase@localhost>
Date: Fri, 30 Oct 2026 17:01:29 +0000
Subject: [PATCH 15/24] 07-licm-integer-bindings-in-polled-loops

---
 backend/cmm_strength_reduction.ml |  6 +++++-
 driver/oxcaml_args.ml             | 17 +++++++++++++++++
 driver/oxcaml_args.mli            |  2 ++
 driver/oxcaml_flags.ml            |  3 +++
 driver/oxcaml_flags.mli           |  2 ++
 5 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/backend/cmm_strength_reduction.ml b/backend/cmm_strength_reduction.ml
index ff744531d3..c8a1a10704 100644
--- a/backend/cmm_strength_reduction.ml
+++ b/backend/cmm_strength_reduction.ml
@@ -2536,8 +2536,12 @@ let rec rewrite (config : config) int_vars expr =
         let relaxed = form_interior_pointers && gc_free in
         (* Invariants first: what leaves the loop here is bound outside it, so the
            passes below may treat it as loop-invariant. *)
+        (* Without [relaxed] only integer operands qualify ([invariant_int]),
+           and an integer means the same before the loop as in it whatever
+           the collector does in between, so a loop that keeps its poll, or
+           calls or allocates, may hoist those too. *)
         let hoisted, expr =
-          if not (licm && relaxed)
+          if not (licm && (relaxed || !Oxcaml_flags.cmm_licm_polled))
           then [], expr
           else
             match
diff --git a/driver/oxcaml_args.ml b/driver/oxcaml_args.ml
index f6f0d2bff3..5d819b94f0 100644
--- a/driver/oxcaml_args.ml
+++ b/driver/oxcaml_args.ml
@@ -231,6 +231,16 @@ let mk_no_cmm_counted_loops f =
     Arg.Unit f,
     " Keep the back-edge poll of every loop" )
 
+let mk_cmm_licm_polled f =
+  ( "-cmm-licm-polled",
+    Arg.Unit f,
+    " Also bind loop-invariant integer computations before loops that keep their poll" )
+
+let mk_no_cmm_licm_polled f =
+  ( "-no-cmm-licm-polled",
+    Arg.Unit f,
+    " Bind loop-invariant computations only before loops without a safepoint" )
+
 let mk_cfg_stack_checks f =
   ( "-cfg-stack-checks",
     Arg.Unit f,
@@ -1517,6 +1527,8 @@ module type Oxcaml_options = sig
   val cmm_unchecked_loops : unit -> unit
   val no_cmm_unchecked_loops : unit -> unit
   val dcounted_loops : unit -> unit
+  val cmm_licm_polled : unit -> unit
+  val no_cmm_licm_polled : unit -> unit
   val cfg_stack_checks : unit -> unit
   val no_cfg_stack_checks : unit -> unit
   val cfg_stack_checks_threshold : int -> unit
@@ -1747,6 +1759,8 @@ module Make_oxcaml_options (F : Oxcaml_options) = struct
       mk_cmm_unchecked_loops F.cmm_unchecked_loops;
       mk_no_cmm_unchecked_loops F.no_cmm_unchecked_loops;
       mk_dcounted_loops F.dcounted_loops;
+      mk_cmm_licm_polled F.cmm_licm_polled;
+      mk_no_cmm_licm_polled F.no_cmm_licm_polled;
       mk_cfg_stack_checks F.cfg_stack_checks;
       mk_no_cfg_stack_checks F.no_cfg_stack_checks;
       mk_cfg_stack_checks_threshold F.cfg_stack_checks_threshold;
@@ -2133,6 +2147,8 @@ module Oxcaml_options_impl = struct
   let cmm_unchecked_loops = set' Oxcaml_flags.cmm_unchecked_loops
   let no_cmm_unchecked_loops = clear' Oxcaml_flags.cmm_unchecked_loops
   let dcounted_loops = set' Oxcaml_flags.dump_counted_loops
+  let cmm_licm_polled = set' Oxcaml_flags.cmm_licm_polled
+  let no_cmm_licm_polled = clear' Oxcaml_flags.cmm_licm_polled
   let cfg_stack_checks = set' Oxcaml_flags.cfg_stack_checks
   let no_cfg_stack_checks = clear' Oxcaml_flags.cfg_stack_checks
 
@@ -2766,6 +2782,7 @@ module Extra_params = struct
     | "cmm-licm" -> set' Oxcaml_flags.cmm_licm
     | "cmm-counted-loops" -> set' Oxcaml_flags.cmm_counted_loops
     | "cmm-unchecked-loops" -> set' Oxcaml_flags.cmm_unchecked_loops
+    | "cmm-licm-polled" -> set' Oxcaml_flags.cmm_licm_polled
     | "cfg-stack-checks" -> set' Oxcaml_flags.cfg_stack_checks
     | "cfg-eliminate-dead-trap-handlers" ->
         set' Oxcaml_flags.cfg_eliminate_dead_trap_handlers
diff --git a/driver/oxcaml_args.mli b/driver/oxcaml_args.mli
index f62a6eb7de..241895e976 100644
--- a/driver/oxcaml_args.mli
+++ b/driver/oxcaml_args.mli
@@ -66,6 +66,8 @@ module type Oxcaml_options = sig
   val cmm_unchecked_loops : unit -> unit
   val no_cmm_unchecked_loops : unit -> unit
   val dcounted_loops : unit -> unit
+  val cmm_licm_polled : unit -> unit
+  val no_cmm_licm_polled : unit -> unit
   val cfg_stack_checks : unit -> unit
   val no_cfg_stack_checks : unit -> unit
   val cfg_stack_checks_threshold : int -> unit
diff --git a/driver/oxcaml_flags.ml b/driver/oxcaml_flags.ml
index 01a22bfb26..f43e4efd93 100644
--- a/driver/oxcaml_flags.ml
+++ b/driver/oxcaml_flags.ml
@@ -62,6 +62,9 @@ let cmm_unchecked_loops = ref false     (* -[no-]cmm-unchecked-loops *)
 
 let dump_counted_loops = ref false      (* -dcounted-loops *)
 
+(* Loop-invariant code motion out of loops that may reach a safepoint, restricted to integer operands, which the collector never moves. See cmm_strength_reduction.ml. *)
+let cmm_licm_polled = ref true  (* -[no]-cmm-licm-polled *)
+
 let cfg_stack_checks = ref true         (* -[no-]cfg-stack-check *)
 let cfg_stack_checks_threshold = ref 16384 (* -cfg-stack-threshold *)
 
diff --git a/driver/oxcaml_flags.mli b/driver/oxcaml_flags.mli
index 9aeb795f2f..f48fd4dbaf 100644
--- a/driver/oxcaml_flags.mli
+++ b/driver/oxcaml_flags.mli
@@ -55,6 +55,8 @@ val cmm_unchecked_loops : bool ref
 
 val dump_counted_loops : bool ref
 
+val cmm_licm_polled : bool ref
+
 val cfg_stack_checks : bool ref
 val cfg_stack_checks_threshold : int ref
 
-- 
2.47.3

