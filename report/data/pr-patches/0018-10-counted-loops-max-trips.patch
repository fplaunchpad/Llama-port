diff --git a/backend/cmm_strength_reduction.ml b/backend/cmm_strength_reduction.ml
index 786d2b56ab..b9af2487ac 100644
--- a/backend/cmm_strength_reduction.ml
+++ b/backend/cmm_strength_reduction.ml
@@ -2469,6 +2469,51 @@ let with_lifted ~dbg pre lifted =
       }
   | Never, _ :: _ -> Never
 
+(* -cmm-counted-loops-max-trips [cap]: the poll-free version also requires the
+   loop to be within [cap] steps of its bound on entry, which bounds the time
+   it can keep a stop-the-world collection waiting by [cap] iterations rather
+   than by the loop's whole run.
+
+   With [x0] the guarded value on entry and [d] its step, a loop that passes
+   the check [distance <=u cap * |d|], where [distance] is [B - x0] for [d > 0]
+   and [x0 - B] for [d < 0] (wrapping), takes at most [cap] back edges: the
+   termination proof already guarantees that [x] moves monotonically towards
+   [B] without wrapping while the loop continues, so after [t] back edges the
+   true difference is at least [t * |d|] while still positive, and that
+   difference is the unsigned value of [distance]. If [x0] is already past
+   [B] the guard fails on the first iteration whatever the check says. An
+   equality guard ends within two iterations and needs no check.
+
+   The check reads the counter's entry value, so it cannot be lifted out of
+   an enclosing loop ([specialize]): with a cap, a nest is counted only at
+   its innermost capped level, and the loops around it keep their polls. *)
+let with_trip_cap ~dbg (guard : guard) pre =
+  let cap = !Oxcaml_flags.cmm_counted_loops_max_trips in
+  let d = abs guard.step in
+  if cap <= 0 || d = 0 || cap > Int.max_int / d
+  then pre, false
+  else
+    match guard.continue_when, pre with
+    | Ceq, _ | _, Never -> pre, false
+    | _, (Always | Check _) ->
+      let limit = Cconst_natint (Nativeint.of_int (cap * d), dbg) in
+      let within start =
+        let x0 = apply_affine guard.affine start dbg in
+        let distance =
+          if guard.step > 0
+          then Cop (Csubi, [guard.bound; x0], dbg)
+          else Cop (Csubi, [x0; guard.bound], dbg)
+        in
+        Cop (Ccmpi Cule, [distance; limit], dbg)
+      in
+      let check =
+        match pre with
+        | Check { check; _ } ->
+          fun start -> Cop (Cand, [check start; within start], dbg)
+        | Always | Never -> within
+      in
+      Check { check; uses_start = true }, true
+
 (* -dcounted-loops *)
 let report ~fn ~dbg decision =
   if !Oxcaml_flags.dump_counted_loops
@@ -2671,8 +2716,15 @@ let rec rewrite (config : config) int_vars expr =
                   decline "an entry check, in a [@poll error] function"
                 | Some (guard, pre) ->
                   let pre = with_lifted ~dbg pre lifted in
+                  (* A [@poll error] function promises never to poll, so it
+                     gets no capped polled copy either. *)
+                  let pre, capped =
+                    if fn.in_poll_error_function
+                    then pre, false
+                    else with_trip_cap ~dbg guard pre
+                  in
                   report ~fn ~dbg
-                    (Printf.sprintf "counted, %s%s"
+                    (Printf.sprintf "counted, %s%s%s"
                        (match pre with
                        | Always | Never -> "no entry check"
                        | Check _ -> "entry check")
@@ -2680,7 +2732,8 @@ let rec rewrite (config : config) int_vars expr =
                        | [] -> ""
                        | _ :: _ ->
                          Printf.sprintf " (%d inner check(s) lifted)"
-                           (List.length lifted)));
+                           (List.length lifted))
+                       (if capped then " (trip cap)" else ""));
                   Some (original, handler, node, guard, pre)))
           | _, _ :: _ :: _ ->
             report ~fn
