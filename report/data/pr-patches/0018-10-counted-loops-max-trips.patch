+(* A cap on the stop-the-world latency a counted loop can add: a loop that may run more than this many iterations runs its polled copy instead. 0 means no cap. *)
+let cmm_counted_loops_max_trips = ref 0  (* -cmm-counted-loops-max-trips *)
+
 let dump_cmm_loops = ref false  (* -dcmm-loops *)
 
 (* Loop-invariant code motion out of loops that may reach a safepoint, restricted to integer operands, which the collector never moves. See cmm_strength_reduction.ml. *)
