+let mk_cmm_counted_loops_max_trips f =
+  ( "-cmm-counted-loops-max-trips",
+    Arg.Int f,
+    "<n>  Make a counted loop poll-free only when it ends within about n iterations, checked on entry; otherwise run its polled copy (default 0: no limit)" )
+
 let mk_cfg_stack_checks f =
   ( "-cfg-stack-checks",
     Arg.Unit f,
@@ -1532,6 +1537,7 @@ module type Oxcaml_options = sig
   val cmm_unchecked_loops : unit -> unit
   val no_cmm_unchecked_loops : unit -> unit
   val dcounted_loops : unit -> unit
+  val cmm_counted_loops_max_trips : int -> unit
   val dcmm_loops : unit -> unit
   val cmm_licm_polled : unit -> unit
   val no_cmm_licm_polled : unit -> unit
@@ -1765,6 +1771,7 @@ module Make_oxcaml_options (F : Oxcaml_options) = struct
       mk_cmm_unchecked_loops F.cmm_unchecked_loops;
       mk_no_cmm_unchecked_loops F.no_cmm_unchecked_loops;
       mk_dcounted_loops F.dcounted_loops;
+      mk_cmm_counted_loops_max_trips F.cmm_counted_loops_max_trips;
       mk_dcmm_loops F.dcmm_loops;
       mk_cmm_licm_polled F.cmm_licm_polled;
       mk_no_cmm_licm_polled F.no_cmm_licm_polled;
@@ -2154,6 +2161,7 @@ module Oxcaml_options_impl = struct
   let cmm_unchecked_loops = set' Oxcaml_flags.cmm_unchecked_loops
   let no_cmm_unchecked_loops = clear' Oxcaml_flags.cmm_unchecked_loops
   let dcounted_loops = set' Oxcaml_flags.dump_counted_loops
+  let cmm_counted_loops_max_trips n = Oxcaml_flags.cmm_counted_loops_max_trips := n
   let dcmm_loops = set' Oxcaml_flags.dump_cmm_loops
   let cmm_licm_polled = set' Oxcaml_flags.cmm_licm_polled
   let no_cmm_licm_polled = clear' Oxcaml_flags.cmm_licm_polled
@@ -2790,6 +2798,7 @@ module Extra_params = struct
     | "cmm-licm" -> set' Oxcaml_flags.cmm_licm
     | "cmm-counted-loops" -> set' Oxcaml_flags.cmm_counted_loops
     | "cmm-unchecked-loops" -> set' Oxcaml_flags.cmm_unchecked_loops
+    | "cmm-counted-loops-max-trips" -> set_int' Oxcaml_flags.cmm_counted_loops_max_trips
     | "cmm-licm-polled" -> set' Oxcaml_flags.cmm_licm_polled
     | "cfg-stack-checks" -> set' Oxcaml_flags.cfg_stack_checks
     | "cfg-eliminate-dead-trap-handlers" ->
